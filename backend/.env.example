# ==========================================
# SIMIKP BACKEND CONFIGURATION TEMPLATE
# Copy file ini menjadi .env dan isi nilainya
# ==========================================

# 1. Konfigurasi Server Dasar
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://simikp.kominfo.go.id

# 2. Konfigurasi Database (MySQL)
# Ganti dengan connection string MySQL milik Kominfo
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DB_REJECT_UNAUTHORIZED=false

# 3. Kunci Rahasia Keamanan (Wajib diganti dengan teks acak yang panjang)
JWT_SECRET=isi_dengan_teks_acak_rahasia_untuk_jwt
COOKIE_SECRET=isi_dengan_teks_acak_rahasia_untuk_cookie

# 4. Pengaturan Penyimpanan (Bank Konten)
MAX_FILE_SIZE_MB=4096
STORAGE_PATH=./storage

# 5. Konfigurasi Email Notifikasi (Opsional - Jika ingin fitur notifikasi email berfungsi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email-pengirim@gmail.com
SMTP_PASS=password-aplikasi-email
SMTP_FROM="SIMIKP Pemkot Batu <email-pengirim@gmail.com>"
